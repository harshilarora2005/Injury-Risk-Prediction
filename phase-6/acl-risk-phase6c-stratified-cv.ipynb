import os, json, pickle, random
import numpy as np
import pandas as pd
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader, WeightedRandomSampler
from sklearn.model_selection import StratifiedKFold
from sklearn.metrics import f1_score, roc_auc_score
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import matplotlib.patches as mpatches

random.seed(42); np.random.seed(42); torch.manual_seed(42)
torch.backends.cudnn.deterministic = True

DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print(f"Device: {DEVICE}")
if torch.cuda.is_available():
    print(torch.cuda.get_device_name(0))


with open("/kaggle/input/datasets/risha8750/phase5-outputs/train_samples.pkl","rb") as f:
    tr_s = pickle.load(f)
with open("/kaggle/input/datasets/risha8750/acl-phase5-pkl/val_samples.pkl","rb") as f:
    vl_s = pickle.load(f)

print(f"train: {len(tr_s):,}  val: {len(vl_s):,}")
print(f"keys: {list(tr_s[0].keys())}")
print(f"feat shape: {tr_s[0]['features'].shape}")
print(f"label eg: {tr_s[0]['label']}")


LBL = {"Low":0, "Medium":1, "High":2}

with open("/kaggle/input/notebooks/risha8750/acl-risk-phase6-full-lstm/class_weights_final.json","r") as f:
    cw = json.load(f)

cw_tensor = torch.tensor([cw["Low"],cw["Medium"],cw["High"]], dtype=torch.float32).to(DEVICE)
print("class weights:", cw_tensor)

all_s = tr_s + vl_s
print(f"total pool: {len(all_s):,}")

all_lbls = np.array([LBL[s['label']] for s in all_s])
cnts = np.bincount(all_lbls, minlength=3)
print(f"Low={cnts[0]:,}  Med={cnts[1]:,}  High={cnts[2]:,}")


class ACLRiskLSTM(nn.Module):
    def __init__(self, in_sz=8, h_sz=128, n_layers=2, drop=0.4, n_cls=3):
        super().__init__()
        self.lstm = nn.LSTM(in_sz, h_sz, n_layers,
                            dropout=drop if n_layers>1 else 0.0,
                            batch_first=True, bidirectional=True)
        self.drop = nn.Dropout(drop)
        self.fc   = nn.Linear(h_sz*2, n_cls)
    def forward(self, x):
        out,_ = self.lstm(x)
        out   = out[:,-1,:]
        out   = self.drop(out)
        return self.fc(out)


class RiskSeqDataset(Dataset):
    def __init__(self, samples, lbl_map, aug=False):
        self.samples = samples
        self.lbl_map = lbl_map
        self.aug = aug
    def __len__(self):
        return len(self.samples)
    def __getitem__(self, idx):
        s = self.samples[idx]
        feat = s['features'].astype(np.float32)
        if self.aug:
            feat = feat + np.random.normal(0,0.01,feat.shape).astype(np.float32)
        x = torch.tensor(feat, dtype=torch.float32)
        y = torch.tensor(self.lbl_map[s['label']], dtype=torch.long)
        return x,y


def quick_eval(model, loader, device, lbl_map):
    model.eval()
    preds,probs,tgts = [],[],[]
    with torch.no_grad():
        for x,y in loader:
            x,y = x.to(device), y.to(device)
            logits = model(x)
            p = torch.softmax(logits, dim=1)
            preds.extend(torch.argmax(logits,1).cpu().numpy())
            probs.extend(p.cpu().numpy())
            tgts.extend(y.cpu().numpy())
    preds = np.array(preds); probs = np.array(probs); tgts = np.array(tgts)
    f1 = f1_score(tgts, preds, average='macro', zero_division=0)
    try:
        auc = roc_auc_score(tgts, probs, multi_class='ovr', average='macro')
    except ValueError:
        auc = float('nan')
    return f1, auc


skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
results = []

for fi,(tr_idx,vl_idx) in enumerate(skf.split(all_s, all_lbls)):
    print(f"\n{'='*55}\nFOLD {fi+1}/5  |  tr={len(tr_idx):,}  vl={len(vl_idx):,}")

    f_tr = [all_s[i] for i in tr_idx]
    f_vl = [all_s[i] for i in vl_idx]

    tr_ds = RiskSeqDataset(f_tr, LBL, aug=True)
    vl_ds = RiskSeqDataset(f_vl, LBL, aug=False)

    f_lbls   = np.array([LBL[s['label']] for s in f_tr])
    f_cnts   = np.bincount(f_lbls, minlength=3)
    csw      = 1.0 / np.maximum(f_cnts,1)
    sw       = torch.tensor([csw[l] for l in f_lbls], dtype=torch.float32)
    sampler  = WeightedRandomSampler(sw, len(sw), replacement=True)
    print(f"  Low={f_cnts[0]:,}  Med={f_cnts[1]:,}  High={f_cnts[2]:,}")

    tr_ldr = DataLoader(tr_ds, batch_size=256, sampler=sampler, num_workers=2, pin_memory=True)
    vl_ldr = DataLoader(vl_ds, batch_size=256, shuffle=False,  num_workers=2, pin_memory=True)

    model = ACLRiskLSTM().to(DEVICE)
    crit  = nn.CrossEntropyLoss(weight=cw_tensor)
    opt   = torch.optim.Adam(model.parameters(), lr=1.01e-4)

    b_f1=- 1.0; b_auc=0.0; b_state=None; no_imp=0

    for ep in range(1,31):
        model.train()
        run_loss = 0.0
        for x,y in tr_ldr:
            x,y = x.to(DEVICE), y.to(DEVICE)
            opt.zero_grad()
            loss = crit(model(x), y)
            loss.backward()
            opt.step()
            run_loss += loss.item()
        vf1,vauc = quick_eval(model, vl_ldr, DEVICE, LBL)
        print(f"  ep{ep:02d} | loss={run_loss/len(tr_ldr):.4f} | f1={vf1:.4f} | auc={vauc:.4f}")
        if vf1 > b_f1:
            b_f1=vf1; b_auc=vauc
            b_state = {k:v.cpu().clone() for k,v in model.state_dict().items()}
            no_imp=0
        else:
            no_imp+=1
        if no_imp>=5:
            print(f"  early stop @ ep{ep}")
            break

    model.load_state_dict(b_state); model.to(DEVICE)
    ff1,fauc = quick_eval(model, vl_ldr, DEVICE, LBL)
    print(f"\n  Fold {fi+1} final → F1={ff1:.4f}  AUROC={fauc:.4f}")
    results.append({"fold":fi+1,"f1":ff1,"auroc":fauc})

    del model,opt,tr_ds,vl_ds,tr_ldr,vl_ldr
    torch.cuda.empty_cache()

print("\n" + "="*55 + "\nAll folds done.")


df = pd.DataFrame(results)
mf1  = df['f1'].mean();    sf1  = df['f1'].std()
mauc = df['auroc'].mean(); sauc = df['auroc'].std()

print("="*50)
print(f"Mean F1    : {mf1:.4f}  ±  {sf1:.4f}")
print(f"Mean AUROC : {mauc:.4f}  ±  {sauc:.4f}")
print("="*50)
print(df.to_string(index=False))


df.to_csv("cross_validation_results.csv", index=False)
print("saved: cross_validation_results.csv")
print(df)


fig,ax = plt.subplots(figsize=(10,6))
fig.patch.set_facecolor('#1a1a2e')
ax.set_facecolor('#16213e')

x = np.arange(len(df))
bars = ax.bar(x, df['f1'], width=0.5, color='#4cc9f0',
              edgecolor='#0077b6', linewidth=1.5, zorder=3, label='Fold F1')
ax.axhline(mf1, color='#f72585', linewidth=2.0, linestyle='--',
           label=f'Mean={mf1:.4f}', zorder=4)
ax.axhspan(mf1-sf1, mf1+sf1, alpha=0.15, color='#f72585',
           label=f'±std({sf1:.4f})', zorder=2)

for bar,val in zip(bars, df['f1']):
    ax.text(bar.get_x()+bar.get_width()/2, bar.get_height()+0.003,
            f'{val:.4f}', ha='center', va='bottom',
            color='white', fontsize=11, fontweight='bold')

ax.set_xticks(x)
ax.set_xticklabels([f'Fold {i}' for i in df['fold']], color='white', fontsize=12)
ax.set_ylim(max(0,mf1-0.15), min(1.02,mf1+0.15))
ax.set_yticks(np.arange(round(max(0,mf1-0.15),1), min(1.02,mf1+0.15), 0.05))
ax.tick_params(axis='y', colors='white')
ax.set_xlabel('Fold', color='white', fontsize=13)
ax.set_ylabel('Macro F1', color='white', fontsize=13)
ax.set_title('Phase 6C — 5-Fold CV\nACL Risk BiLSTM | CMU MoCap + Penn Action',
             color='white', fontsize=14, pad=15)
for sp in ax.spines.values(): sp.set_edgecolor('#444')
ax.legend(facecolor='#1a1a2e', labelcolor='white', fontsize=11, loc='lower right')
ax.grid(axis='y', color='#333', linestyle='--', linewidth=0.8, zorder=1)
plt.tight_layout()
plt.savefig("cross_validation_plot.png", dpi=150, bbox_inches='tight',
            facecolor=fig.get_facecolor())
plt.close()
print("saved: cross_validation_plot.png")


