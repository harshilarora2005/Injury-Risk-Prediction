ax.set_xlabel('Macro F1 Drop', fontsize=11)
ax.set_title(f'Phase 6D — Feature Permutation Sensitivity\nBaseline F1: {base_f1:.4f}',
             fontsize=13, fontweight='bold')
ax.axvline(0.004, color='#d32f2f', linestyle='--', linewidth=1.2, alpha=0.6,
           label='0.004 threshold')
ax.legend(fontsize=9)
ax.invert_yaxis()
ax.grid(axis='x', alpha=0.3)
plt.tight_layout()
plt.savefig('/kaggle/working/feature_importance.png', dpi=150, bbox_inches='tight')
plt.show()


