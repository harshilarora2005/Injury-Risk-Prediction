def linear_sub_score(value, safe_max, risk_min):
    if value <= safe_max: return 0.0
    if value >= risk_min: return 1.0
    return float((value - safe_max) / (risk_min - safe_max))

def assign_composite_label(win):
    l_knee, r_knee = win[:,0], win[:,1]
    trunk, asym = win[:,4], win[:,5]
    vel = (np.abs(win[:,6]) + np.abs(win[:,7])) / 2.0

    knee_avg = (np.nanmean(l_knee) + np.nanmean(r_knee)) / 2.0
    deviation = 170.0 - knee_avg
    if deviation <= 0: s_knee = 0.0
    elif deviation >= 70.0: s_knee = 1.0
    else: s_knee = float((deviation - 30.0) / 40.0) if deviation > 30.0 else 0.0

    trunk_dev = 180.0 - np.nanmean(np.abs(trunk))
    if trunk_dev <= 10.0: s_trunk = 0.0
    elif trunk_dev >= 25.0: s_trunk = 1.0
    else: s_trunk = float((trunk_dev - 10.0) / 15.0)

    s_asym = linear_sub_score(float(np.nanmean(np.abs(asym))), 5.0, 15.0)
    s_vel  = linear_sub_score(float(np.nanpercentile(np.abs(vel), 90)), 150.0, 300.0)

    score = 0.40*s_knee + 0.30*s_asym + 0.15*s_trunk + 0.15*s_vel
    label = 'Low' if score <= 0.33 else ('Medium' if score <= 0.66 else 'High')
    return label

for s in val_samples:
    s['label'] = assign_composite_label(s['features'])

from collections import Counter
print("Relabeled val distribution:", Counter(s['label'] for s in val_samples))


model = ACLRiskLSTM().to(DEVICE)
model.load_state_dict(torch.load('/kaggle/input/notebooks/risha8750/acl-risk-phase6-full-lstm/best_acl_lstm.pt',
                                  map_location=DEVICE))
model.eval()

def quick_eval(mdl, ldr, dev):
    preds, labels = [], []
    with torch.no_grad():
        for xb, yb in ldr:
            xb = xb.to(dev)
            p = mdl(xb).argmax(dim=1).cpu().numpy()
            preds.extend(p)
            labels.extend(yb.numpy())
    return f1_score(labels, preds, labels=[1,2], average='macro')

val_loader = DataLoader(RiskSequenceDataset(val_samples), batch_size=512,
                        shuffle=False, num_workers=2, pin_memory=True)
base_f1 = quick_eval(model, val_loader, DEVICE)
print(f"Baseline F1 (Medium+High): {base_f1:.6f}")


feat_names = [
    'left_knee_flexion',
    'right_knee_flexion',
    'hip_flexion',
    'knee_asymmetry',
    'trunk_lean',
    'angular_velocity',
    'angular_acceleration',
    'hip_angular_velocity'
]

rows = []
for i, fname in enumerate(feat_names):
    perturbed = copy.deepcopy(val_samples)
    for s in perturbed:
        col = s['features'][:, i].copy()
        np.random.shuffle(col)
        s['features'][:, i] = col
    ldr = DataLoader(RiskSequenceDataset(perturbed), batch_size=512,
                     shuffle=False, num_workers=2, pin_memory=True)
    pf1 = quick_eval(model, ldr, DEVICE)
    drop = base_f1 - pf1
    rows.append({'feature':fname, 'perturbed_f1':pf1, 'f1_drop':drop})
    print(f"[{i+1}/8] {fname:<28} perturbed={pf1:.6f}  drop={drop:+.6f}")


df = pd.DataFrame(rows).sort_values('f1_drop', ascending=False).reset_index(drop=True)
df['baseline_f1'] = base_f1
df = df[['feature','baseline_f1','perturbed_f1','f1_drop']]
df.to_csv('/kaggle/working/feature_importance.csv', index=False)
print(df.to_string(index=False))


