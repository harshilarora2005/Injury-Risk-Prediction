def deep_explore(root, max_depth=3, max_files=8):
    print(f"\n{'═'*55}\n{root}\n{'═'*55}")
    for dp, dirs, files in os.walk(root):
        depth = dp.replace(root, '').count(os.sep)
        if depth > max_depth: continue
        pad = '  ' * depth
        print(f"{pad}[{os.path.basename(dp)}/]")
        for f in sorted(files)[:max_files]:
            kb = os.path.getsize(os.path.join(dp, f)) / 1024
            print(f"{pad}  {f}  ({kb:.1f} KB)")
        if len(files) > max_files:
            print(f"{pad}  ... +{len(files)-max_files} more")

deep_explore(ATHLETICS_DIR, max_depth=3)


