import cv2, scipy.io
import mediapipe as mp
from mediapipe.tasks import python as mp_python
from mediapipe.tasks.python import vision as mp_vision

PENN_DIR   = '/kaggle/input/datasets/kaushalbora18/penn-action-dataset/Penn_Action'
MODEL_PATH = '/kaggle/working/pose_landmarker.task'
OUTPUT_DIR = '/kaggle/working/phase3_outputs'
os.makedirs(OUTPUT_DIR, exist_ok=True)

# ── Download model if needed ───────────────────────────────────────────────
if not os.path.exists(MODEL_PATH) or os.path.getsize(MODEL_PATH) < 100_000:
    print("Downloading pose model...")
    os.system(
        "wget -q -O /kaggle/working/pose_landmarker.task "
        "https://storage.googleapis.com/mediapipe-models/pose_landmarker/"
        "pose_landmarker_full/float16/latest/pose_landmarker_full.task"
    )
print(f"Model: {os.path.getsize(MODEL_PATH)/1024/1024:.1f} MB ✓")

# ── Skeleton drawing ───────────────────────────────────────────────────────
POSE_CONNECTIONS = [
    (11,12),(11,13),(13,15),(12,14),(14,16),
    (11,23),(12,24),(23,24),
    (23,25),(25,27),(24,26),(26,28),
    (27,29),(29,31),(28,30),(30,32)
]

def draw_skeleton(frame, landmarks):
    h, w = frame.shape[:2]
    for lm in landmarks:
        if lm.visibility > 0.5:
            cv2.circle(frame, (int(lm.x*w), int(lm.y*h)), 5, (0,255,0), -1)
    for s, e in POSE_CONNECTIONS:
        ls, le = landmarks[s], landmarks[e]
        if ls.visibility > 0.5 and le.visibility > 0.5:
            cv2.line(frame, (int(ls.x*w), int(ls.y*h)),
                            (int(le.x*w), int(le.y*h)), (255,255,255), 2)
    return frame

def normalize_mediapipe(landmarks):
    xs = [lm.x for lm in landmarks if lm.visibility > 0.5]
    ys = [lm.y for lm in landmarks if lm.visibility > 0.5]
    if not xs: return None
    x_min, bw = min(xs), max(xs) - min(xs) + 1e-8
    y_min, bh = min(ys), max(ys) - min(ys) + 1e-8
    return [((lm.x-x_min)/bw, (lm.y-y_min)/bh, lm.visibility) for lm in landmarks]

# ── Penn Action clip processor ─────────────────────────────────────────────
def process_penn_clip_rows(clip_info, output_video_path, fps=30.0):
    img_files = sorted(glob.glob(os.path.join(clip_info['frames_dir'], '*.jpg')))
    if not img_files: return []
    sample = cv2.imread(img_files[0])
    if sample is None: return []
    h, w = sample.shape[:2]
    out  = cv2.VideoWriter(output_video_path,
                           cv2.VideoWriter_fourcc(*'mp4v'), fps, (w, h))
    base_options = mp_python.BaseOptions(model_asset_path=MODEL_PATH)
    opts = mp_vision.PoseLandmarkerOptions(
        base_options=base_options,
        running_mode=mp_vision.RunningMode.IMAGE
    )
    rows, dropped = [], 0
    with mp_vision.PoseLandmarker.create_from_options(opts) as detector:
        for frame_idx, img_path in enumerate(img_files):
            frame = cv2.imread(img_path)
            if frame is None: dropped += 1; continue
            rgb    = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            mp_img = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb)
            result = detector.detect(mp_img)
            if result.pose_landmarks:
                lms   = result.pose_landmarks[0]
                frame = draw_skeleton(frame, lms)
                norm  = normalize_mediapipe(lms)
                if norm:
                    row = {
                        'source':  'penn',
                        'action':  clip_info['action'],
                        'clip_id': clip_info['clip_id'],
                        'cam_id':  'single',
                        'frame':   frame_idx,
                    }
                    row.update(extract_biomech_row(norm, source_type='mediapipe'))
                    rows.append(row)
                else: dropped += 1
            else: dropped += 1
            out.write(frame)
    out.release()
    total = len(rows) + dropped
    dpct  = (dropped/total*100) if total else 0
    flag  = "⚠️  HIGH DROP" if dpct > 30 else "✓"
    print(f"  {flag}  {clip_info['clip_id']} ({clip_info['action']}): "
          f"{len(rows)} frames / {dropped} dropped ({dpct:.1f}%)")
    return rows

# ── Penn Action: filter relevant clips ────────────────────────────────────
KEEP_PENN = {'jumping','squat','jump_rope','jumping_jacks','bench_press','pull_ups'}
label_files = sorted(glob.glob(os.path.join(PENN_DIR, 'labels', '*.mat')))
valid_penn_clips = []

for lf in label_files:
    try:
        data   = scipy.io.loadmat(lf)
        action = str(data.get('action', [['']])[0]).strip().lower().replace(' ','_')
        if any(k in action for k in KEEP_PENN):
            cid = os.path.splitext(os.path.basename(lf))[0]
            fd  = os.path.join(PENN_DIR, 'frames', cid)
            if os.path.isdir(fd):
                valid_penn_clips.append({'clip_id':cid, 'action':action, 'frames_dir':fd})
    except: pass

print(f"Penn clips to process: {len(valid_penn_clips)}")
print(f"Actions found: {set(c['action'] for c in valid_penn_clips)}\n")

# ══════════════════════════════════════════════════════════════════════════
# FULL BATCH RUN
# ══════════════════════════════════════════════════════════════════════════
all_rows    = []
summary_log = []

# ── Part 1: AthleticsPose ─────────────────────────────────────────────────
print(f"Loading {len(valid_athletics_files)} AthleticsPose files...")
for i, finfo in enumerate(valid_athletics_files):
    rows = load_athletics_clip_rows(finfo)
    if rows:
        all_rows.extend(rows)
        summary_log.append({'source':'athletics', 'action':finfo['action'],
                             'clip':finfo['clip_id'], 'frames':len(rows), 'status':'OK'})
    else:
        summary_log.append({'source':'athletics', 'action':finfo['action'],
                             'clip':finfo['clip_id'], 'frames':0, 'status':'FAILED'})
    if (i+1) % 200 == 0:
        print(f"  [{i+1}/{len(valid_athletics_files)}] rows so far: {len(all_rows):,}")

athletics_frame_count = len(all_rows)
print(f"\nAthleticsPose done: {athletics_frame_count:,} frames\n")

# ── Part 2: Penn Action ───────────────────────────────────────────────────
print(f"Processing {len(valid_penn_clips)} Penn Action clips...")
for i, clip in enumerate(valid_penn_clips):
    out_vid = os.path.join(OUTPUT_DIR, f"penn_sk_{clip['clip_id']}.mp4")
    print(f"[{i+1}/{len(valid_penn_clips)}]", end=' ')
    rows = process_penn_clip_rows(clip, out_vid)
    if rows:
        all_rows.extend(rows)
        summary_log.append({'source':'penn', 'action':clip['action'],
                             'clip':clip['clip_id'], 'frames':len(rows), 'status':'OK'})
    else:
        summary_log.append({'source':'penn', 'action':clip['action'],
                             'clip':clip['clip_id'], 'frames':0, 'status':'FAILED'})

penn_frame_count = len(all_rows) - athletics_frame_count
print(f"\nPenn Action done: {penn_frame_count:,} frames")

# ── Save everything ────────────────────────────────────────────────────────
master_df  = pd.DataFrame(all_rows)
master_csv = '/kaggle/working/phase3_keypoints_master.csv'
master_df.to_csv(master_csv, index=False)

summary_df = pd.DataFrame(summary_log)
summary_df.to_csv('/kaggle/working/phase3_summary.csv', index=False)

# ── Final report ───────────────────────────────────────────────────────────
print("\n\n════ PHASE 3 COMPLETE ════")
print(f"Master CSV shape  : {master_df.shape}")
print(f"Total frames      : {len(master_df):,}")
print(f"\nBreakdown by source + action:")
print(master_df.groupby(['source','action'])['frame'].count().to_string())
print(f"\nFailed clips      : {(summary_df.status=='FAILED').sum()}")
print(f"File saved to     : {master_csv}")

