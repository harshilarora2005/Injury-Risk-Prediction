print(f"  y range: [{min(all_y):.4f}, {max(all_y):.4f}]  ← must be ~0.0 to ~1.0")

print(f"\nFrame 0 — Left knee  (idx 13): {test_frames[0][13]}")
print(f"Frame 0 — Right knee (idx 14): {test_frames[0][14]}")

# Also test the row-format version
test_rows = load_athletics_clip_rows(test_info)
print(f"\nRow format test:")
print(f"  Rows generated: {len(test_rows)}")
print(f"  Row keys: {list(test_rows[0].keys())}")
print(f"\nSample row:\n{test_rows[0]}")



