import os, glob, numpy as np

ATHLETICS_BASE = '/kaggle/input/datasets/risha8750/athletic-pose/data/AthleticsPoseDataset'
GT_2D_DIR      = os.path.join(ATHLETICS_BASE, 'gt_markers2d_by_cam')

# Actions with lower-body biomechanical relevance for ACL screening
KEEP_ACTIONS = {'sprint', 'hurdle', 'running', 'racewalk', 'sd'}

# Camera selection:
# Filenames: YYYYMMDD_seq_camID.npy  (e.g. 20250126_10_1.npy → cam 1)
# Camera IDs 0–7 (8 cameras total)
# Larger file sizes for cams 1,2,5,6 in sprint/hurdle = more joints visible
# = side-profile views. Cams 0,3,4,7 = end-on (running toward/away from camera)
SIDE_CAMERAS = {'1', '2', '5', '6'}

def get_camera_id(filepath):
    """'20250126_10_1.npy' → '1'"""
    return os.path.splitext(os.path.basename(filepath))[0].split('_')[-1]

valid_athletics_files = []

for action in sorted(os.listdir(GT_2D_DIR)):
    action_path = os.path.join(GT_2D_DIR, action)
    if not os.path.isdir(action_path) or action.lower() not in KEEP_ACTIONS:
        print(f"  ✗ SKIPPED: {action}")
        continue

    action_count = 0
    for subject in sorted(os.listdir(action_path)):
        subject_path = os.path.join(action_path, subject)
        if not os.path.isdir(subject_path):
            continue
        for npy_file in sorted(glob.glob(os.path.join(subject_path, '*.npy'))):
            cam_id = get_camera_id(npy_file)
            if cam_id in SIDE_CAMERAS:
                stem = os.path.splitext(os.path.basename(npy_file))[0]
                valid_athletics_files.append({
                    'path':    npy_file,
                    'action':  action,
                    'subject': subject,
                    'cam_id':  cam_id,
                    'clip_id': f"{action}_{subject}_{stem}"
                })
                action_count += 1

    print(f"  ✓ KEPT: {action:12s} → {action_count} camera files")

print(f"\nTotal AthleticsPose files: {len(valid_athletics_files)}")
print(f"(Each file = one trial × one camera = ~30–300 frames)")



import numpy as np
import pandas as pd
import os, glob

# ══════════════════════════════════════════════════════════════════
# JOINT MAPPING — COCO-17 indices for biomechanically relevant joints
# ══════════════════════════════════════════════════════════════════
BIOMECH_JOINTS = {
    'left_shoulder':  {'coco': 5,  'mediapipe': 11},
    'right_shoulder': {'coco': 6,  'mediapipe': 12},
    'left_hip':       {'coco': 11, 'mediapipe': 23},
    'right_hip':      {'coco': 12, 'mediapipe': 24},
    'left_knee':      {'coco': 13, 'mediapipe': 25},
    'right_knee':     {'coco': 14, 'mediapipe': 26},
    'left_ankle':     {'coco': 15, 'mediapipe': 27},
    'right_ankle':    {'coco': 16, 'mediapipe': 28},
}

# ══════════════════════════════════════════════════════════════════
# NORMALIZATION — pixel coords → 0–1 bounding box
# ══════════════════════════════════════════════════════════════════
def normalize_coco_frame(frame_arr):
    """
    Input:  (17, 3) array — [pixel_x, pixel_y, visibility]
    Output: list of 17 tuples (nx, ny, vis) all in 0–1 range
    """
    xy  = frame_arr[:, :2]
    vis = frame_arr[:, 2]
    valid = vis > 0.5
    if not np.any(valid):
        return None
    xs, ys = xy[valid, 0], xy[valid, 1]
    x_min, bw = xs.min(), xs.max() - xs.min() + 1e-8
    y_min, bh = ys.min(), ys.max() - ys.min() + 1e-8
    return [((xy[i,0]-x_min)/bw, (xy[i,1]-y_min)/bh, float(vis[i]))
            for i in range(17)]

# ══════════════════════════════════════════════════════════════════
# EXTRACT — pull only the 8 biomechanical joints from a full frame
# ══════════════════════════════════════════════════════════════════
def extract_biomech_row(frame_lm, source_type):
    """
    frame_lm:    list of (nx, ny, vis) tuples — full skeleton
    source_type: 'coco' (17 joints) or 'mediapipe' (33 joints)
    Returns:     flat dict with 8 joints × 3 values = 24 columns
    """
    row = {}
    for joint_name, indices in BIOMECH_JOINTS.items():
        idx          = indices[source_type]
        nx, ny, vis  = frame_lm[idx]
        row[f'{joint_name}_x']   = nx
        row[f'{joint_name}_y']   = ny
        row[f'{joint_name}_vis'] = vis
    return row

# ══════════════════════════════════════════════════════════════════
# LOAD — one .npy file → list of normalized per-frame landmarks
# (kept for backward compatibility with sanity check)
# ══════════════════════════════════════════════════════════════════
def load_athletics_npy(file_info):
    """
    Returns list of frames, each frame = list of 17 (nx, ny, vis) tuples.
    Shape expected: (num_frames, 17, 3)
    """
    arr = np.load(file_info['path'])
    if arr.ndim == 2:                     # flat → reshape
        arr = arr.reshape(arr.shape[0], 17, 3)
    all_frames = []
    for frame_arr in arr:
        norm = normalize_coco_frame(frame_arr)
        if norm:
            all_frames.append(norm)
    return all_frames

# ══════════════════════════════════════════════════════════════════
# LOAD ROWS — one .npy file → list of dicts ready for DataFrame
# ══════════════════════════════════════════════════════════════════
def load_athletics_clip_rows(file_info):
    """
    Returns list of row dicts. Each row = one frame with
    source/action/clip metadata + 8 biomechanical joints.
    """
    arr = np.load(file_info['path'])
    if arr.ndim == 2:
        arr = arr.reshape(arr.shape[0], 17, 3)
    rows = []
    for frame_idx, frame_arr in enumerate(arr):
        norm = normalize_coco_frame(frame_arr)
        if norm is None:
            continue
        row = {
            'source':  'athletics',
            'action':  file_info['action'],
            'clip_id': file_info['clip_id'],
            'cam_id':  file_info['cam_id'],
            'frame':   frame_idx,
        }
        row.update(extract_biomech_row(norm, source_type='coco'))
        rows.append(row)
    return rows

print("All functions defined ✓")

# ══════════════════════════════════════════════════════════════════
# SANITY CHECK — run immediately after defining
# ══════════════════════════════════════════════════════════════════
test_info   = valid_athletics_files[0]
test_frames = load_athletics_npy(test_info)

print(f"\nClip:          {test_info['clip_id']}")
print(f"Action:        {test_info['action']}")
